# Database
# For local development (SQLite)
# DATABASE_URL="file:./dev.db"

# For production (PostgreSQL - Vercel Postgres or similar)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-key-using-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app-name.vercel.app"

# Uploadthing (for image/video uploads)
# Get your keys from: https://uploadthing.com/dashboard
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxxxxxx"

# Resend (optional - for email sharing)
# Get your key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Twilio (optional - for SMS sharing)
# Get your credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1234567890"

# Stripe (for marketplace payments)
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
